{
  "folders": [
    {
      "name": "FlightCode",
      "path": "."
    }
  ],
  "settings": {
    "cmake.configurePreset": "debug",
    "cmake.buildPreset": "debug",
    "cmake.sourceDirectory": "${workspaceFolder:FlightCode}",
    "C_Cpp.default.compileCommands": "${workspaceFolder:FlightCode}/build/debug/compile_commands.json",
    "files.associations": {
      "*.h": "c"
    }
  },
  "extensions": {
    "recommendations": [
      "ms-vscode.cmake-tools",
      "ms-vscode.cpptools",
      "marus25.cortex-debug"
    ]
  }
}
