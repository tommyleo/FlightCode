{
  "version": 6,
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "FlightCode Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BOARD": "MAMBAF411"
      }
    },
    {
